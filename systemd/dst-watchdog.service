[Unit]
Description=Check DST updates and update only when both shards are empty

[Service]
Type=oneshot
WorkingDirectory=%h/dst
ExecStart=/usr/bin/python3 %h/dst/scripts/watchdog.py
UMask=0077
Nice=10
TimeoutStartSec=30min
StandardOutput=append:%h/dst/runtime/logs/watchdog.log
StandardError=append:%h/dst/runtime/logs/watchdog.log
