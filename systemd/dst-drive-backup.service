[Unit]
Description=Snapshot DST saves and verify upload to Google Drive

[Service]
Type=oneshot
WorkingDirectory=%h/dst
ExecStart=/bin/bash %h/dst/scripts/drive-backup.sh
UMask=0077
Nice=10
TimeoutStartSec=2h
StandardOutput=append:%h/dst/runtime/logs/drive-backup.log
StandardError=append:%h/dst/runtime/logs/drive-backup.log
